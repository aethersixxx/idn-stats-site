  --color-sand-400: #e5cfaa;
  --color-sand-300: #f0e3cb;
  --color-sand-200: #f5eddd;
  --color-sand-100: #faf6ec;
  --color-sand-50: #fdfbf4;
  --color-ink: #20302f;
  --color-ink-soft: #4f6260;
  --color-muted: #6f7f7d;
  --color-line: #dce4de;
  --color-white: #fffef9;
  --color-positive: #0f766e;
  --color-positive-soft: #d9f0eb;
  --color-negative: #b3563c;
  --color-negative-soft: #f7e1d8;
  --color-focus: #e0a539;
  --shadow-sm: 0 1px 2px rgba(4, 47, 45, 0.08);
  --shadow-md: 0 14px 32px rgba(4, 47, 45, 0.1);
  --shadow-lg: 0 24px 60px rgba(4, 47, 45, 0.14);
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 22px;
  --container: 1180px;
  --font-sans: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.55;
  color: var(--color-ink);
  background:
    radial-gradient(circle at top left, rgba(16, 117, 107, 0.12), transparent 34rem),
    linear-gradient(180deg, var(--color-sand-50) 0%, var(--color-sand-100) 100%);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

a {
  color: var(--color-teal-700);
  text-decoration: none;
}

a:hover {
  color: var(--color-teal-900);
}

button,
select,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

svg {
  max-width: 100%;
  height: auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  color: var(--color-sand-100);
  background: var(--color-teal-950);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: var(--shadow-sm);
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  width: min(var(--container), calc(100% - 32px));
  min-height: 72px;
  margin: 0 auto;
}

.site-brand {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  min-width: 0;
  color: var(--color-sand-100);
}

.site-brand:hover {
  color: var(--color-sand-300);
}

.brand-icon {
  display: block;
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  color: var(--color-teal-500);
  filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.16));
}

.brand-text {
  overflow: hidden;
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.main-nav {
  position: relative;
  display: flex;
  align-items: center;
}

.nav-toggle {
  display: none;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  padding: 0;
  color: var(--color-sand-100);
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: var(--radius-sm);
}

.nav-toggle:hover {
  color: var(--color-white);
  background: rgba(255, 255, 255, 0.08);
}

.nav-toggle:focus-visible {
  outline: 3px solid var(--color-focus);
  outline-offset: 2px;
}

.hamburger,
.hamburger::before,
.hamburger::after {
  display: block;
  width: 20px;
  height: 2px;
  background: currentColor;
  border-radius: 999px;
  transition: transform 180ms ease, opacity 180ms ease;
}

.hamburger {
  position: relative;
}

.hamburger::before,
.hamburger::after {
  content: \"\";
  position: absolute;
  left: 0;
}

.hamburger::before {
  top: -6px;
}

.hamburger::after {
  top: 6px;
}

.nav-toggle[aria-expanded=\"true\"] .hamburger {
  background: transparent;
}

.nav-toggle[aria-expanded=\"true\"] .hamburger::before {
  transform: translateY(6px) rotate(45deg);
}

.nav-toggle[aria-expanded=\"true\"] .hamburger::after {
  transform: translateY(-6px) rotate(-45deg);
}

.nav-list {
  display: flex;
  align-items: center;
  gap: 4px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.nav-link {
  display: inline-flex;
  align-items: center;
  min-height: 40px;
  padding: 8px 13px;
  color: var(--color-teal-100);
  border-radius: 999px;
  font-size: 0.94rem;
  font-weight: 600;
  transition: color 150ms ease, background 150ms ease;
}

.nav-link:hover {
  color: var(--color-white);
  background: rgba(255, 255, 255, 0.08);
}

.nav-link.is-active {
  color: var(--color-teal-950);
  background: var(--color-sand-300);
}

.main-content {
  width: min(var(--container), calc(100% - 32px));
  min-height: calc(100vh - 160px);
  margin: 0 auto;
  padding: 40px 0 64px;
}

.page-section + .page-section {
  margin-top: 36px;
}

.page-heading {
  max-width: 780px;
  margin-bottom: 28px;
}

.eyebrow {
  margin-bottom: 8px;
  color: var(--color-teal-600);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.page-title {
  margin-bottom: 10px;
  color: var(--color-teal-950);
  font-size: clamp(2rem, 5vw, 3.4rem);
  line-height: 1.05;
  letter-spacing: -0.045em;
}

.page-intro {
  max-width: 720px;
  margin-bottom: 0;
  color: var(--color-ink-soft);
  font-size: 1.06rem;
}

.section-title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
}

.section-title {
  margin-bottom: 6px;
  color: var(--color-teal-950);
  font-size: 1.25rem;
  letter-spacing: -0.02em;
}

.section-note {
  margin-bottom: 0;
  color: var(--color-muted);
  font-size: 0.92rem;
}

.panel {
  padding: 22px;
  background: var(--color-white);
  border: 1px solid var(--color-line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.panel + .panel {
  margin-top: 22px;
}

.chart-panel {
  overflow: hidden;
}

.chart-stack {
  display: grid;
  grid-template-columns: 1fr;
  gap: 22px;
}

.chart-stack .panel {
  margin-top: 0;
}

.multi-chart {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 16px;
  margin-bottom: 28px;
}

.kpi-grid {
  align-items: stretch;
}

.card {
  min-width: 0;
  padding: 20px;
  background: var(--color-white);
  border: 1px solid var(--color-line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
}

.card:hover {
  transform: translateY(-3px);
  border-color: var(--color-teal-200);
  box-shadow: var(--shadow-md);
}

.kpi-card {
  display: flex;
  flex-direction: column;
}

.card-label {
  margin-bottom: 12px;
  color: var(--color-ink-soft);
  font-size: 0.9rem;
  font-weight: 700;
}

.kpi-value {
