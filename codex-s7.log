     1	import { INDICATORS, YEARS } from '../data/indicators.js';
     2	import { changeBetween, changePercent, formatValue, page } from '../ui.js';
     3	
     4	function yearOptions(selectedYear) {
     5	  return YEARS.map((year) => {
     6	    const selected = year === selectedYear ? 'selected' : '';
     7	    return `<option value="${year}" ${selected}>${year}</option>`;
     8	  }).join('');
     9	}
    10	
    11	function comparisonRows(startYear, endYear) {
    12	  return INDICATORS.map((indicator) => {
    13	    const start = indicator.values[startYear];
    14	    const end = indicator.values[endYear];
    15	    const delta = changeBetween(indicator, startYear, endYear);
    16	    const percent = changePercent(indicator, startYear, endYear);
    17	    const directionClass = delta >= 0 ? 'is-positive' : 'is-negative';
    18	    const arrow = delta >= 0 ? '↑' : '↓';
    19	    const percentText = percent === null ? '—' : `${formatValue(percent, '%')}%`;
    20	    const barScale = percent === null ? 0 : Math.min(Math.abs(percent), 20);
    21	
    22	    return `
    23	      <tr>
    24	        <th scope="row">
    25	          <span class="table-indicator">${indicator.label}</span>
    26	          <small>${indicator.source} · ${indicator.unit}</small>
    27	        </th>
    28	        <td>${formatValue(start, indicator.unit)}</td>
    29	        <td>${formatValue(end, indicator.unit)}</td>
    30	        <td class="${directionClass}">${arrow} ${Math.abs(delta).toFixed(2)}</td>
    31	        <td>
    32	          <div class="trend-cell">
    33	            <div class="trend-track" aria-hidden="true">
    34	              <span class="trend-center"></span>
    35	              <span class="trend-value ${directionClass}" style="--bar-scale: ${barScale}"></span>
    36	            </div>
    37	            <span class="trend-label">${percentText}</span>
    38	          </div>
    39	        </td>
    40	      </tr>
    41	    `;
    42	  }).join('');
    43	}
    44	
    45	function comparisonTable(startYear, endYear) {
    46	  return `
    47	    <div class="table-wrap">
    48	      <h2 class="section-title">${startYear} vs ${endYear}</h2>
    49	      <table class="data-table compare-table">
    50	        <thead>
    51	          <tr>
    52	            <th>Indikator</th>
    53	            <th>${startYear}</th>
    54	            <th>${endYear}</th>
    55	            <th>Perubahan</th>
    56	            <th>Perubahan relatif</th>
    57	          </tr>
    58	        </thead>
    59	        <tbody>${comparisonRows(startYear, endYear)}</tbody>
    60	      </table>
    61	    </div>
    62	  `;
    63	}
    64	
    65	function renderComparison(body, startYear, endYear) {
    66	  const summary = document.createElement('div');
    67	  summary.className = 'compare-summary';
    68	  summary.innerHTML = `
    69	    <p class="compare-summary-label">Rentang perbandingan</p>
    70	    <p class="compare-summary-value">${startYear} → ${endYear}</p>
    71	    <p class="compare-summary-note">Semua perubahan dihitung terhadap nilai tahun awal.</p>
    72	  `;
    73	  const tableContainer = document.createElement('div');
    74	  tableContainer.innerHTML = comparisonTable(startYear, endYear);
    75	  body.replaceChildren(summary, tableContainer);
    76	}
