export function render(container) {
  const section = page(container, {
    eyebrow: 'Perdagangan dan ekonomi',
    title: 'Ekonomi Indonesia',
    intro: 'Produk domestik bruto, inflasi, serta nilai ekspor dan impor nasional 2015–2024.',
